<UserControl
    x:Class="di.proyecto.clase._2025.Frontend.Dialogos.UCAdministracion"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:di.proyecto.clase._2025.Frontend.Dialogos"
    xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <DockPanel>
        <Grid DockPanel.Dock="Left">
            <ToolBar VerticalAlignment="Top">
                <TextBlock
                    Margin="5"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="Espacios" />
                <Button
                    x:Name="btnListaEspacios"
                    Click="btnEspacios_Click"
                    ToolTip="Listar Espacios">
                    <mat:PackIcon Kind="ListBox" />
                </Button>
            </ToolBar>
        </Grid>

        <Grid x:Name="PanelControl" >
            
        </Grid>
    </DockPanel>
</UserControl>
