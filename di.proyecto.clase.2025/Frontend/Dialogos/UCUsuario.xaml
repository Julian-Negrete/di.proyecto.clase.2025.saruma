<UserControl
    x:Class="di.proyecto.clase._2025.Frontend.Dialogos.UCUsuario"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:di.proyecto.clase._2025.Frontend.Dialogos"
    xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <DockPanel VerticalAlignment="Top">
        <Grid DockPanel.Dock="Top">
            <ToolBar>
                <Button
                    x:Name="btnAgregarUsuario"
                    Click="btnAgregarUsuario_Click"
                    ToolTip="Agregar Usuario">
                    <mat:PackIcon Kind="PlusBoxMultipleOutline" />
                </Button>
                <Button
                    x:Name="btnListaUsuarios"
                    Click="btnListaUsuarios_Click"
                    ToolTip="Listar Usuarios">
                    <mat:PackIcon Kind="ListBox" />
                </Button>
            </ToolBar>
        </Grid>
        <Grid x:Name="PanelControl" />
    </DockPanel>
</UserControl>
