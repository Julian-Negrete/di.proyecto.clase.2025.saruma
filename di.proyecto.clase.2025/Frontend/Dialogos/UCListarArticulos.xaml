<UserControl
    x:Class="di.proyecto.clase._2025.Frontend.Dialogos.UCListarArticulos"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:di.proyecto.clase._2025.Frontend.Dialogos"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="ListarArticulos_Loaded"
    mc:Ignorable="d">

    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="10"
                    HorizontalAlignment="Center"
                    FontSize="25"
                    FontWeight="Bold"
                    Foreground="Black"
                    Text="LISTA DE ARTÍCULOS" />
                <StackPanel
                    Grid.Row="1"
                    Margin="0,0,0,5"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="Black"
                        Style="{StaticResource MahApps.Styles.TextBlock}"
                        Text="Filtros" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="Black"
                        Style="{StaticResource MahApps.Styles.TextBlock}"
                        Text="Por modelo" />
                    <ComboBox
                        Name="cbModelos"
                        Width="150"
                        Margin="5,0,0,0"
                        DisplayMemberPath="Nombre"
                        ItemsSource="{Binding listaModelosArticulos}"
                        SelectedItem="{Binding modeloArticuloSeleccionado}"
                        SelectionChanged="cbModelos_SelectionChanged"
                        Style="{StaticResource MahApps.Styles.ComboBox}" />

                </StackPanel>
            </Grid>


        </Grid>
        <Grid>
            <DataGrid
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                ColumnWidth="*"
                IsReadOnly="True"
                ItemsSource="{Binding listaArticulos}"
                SelectedItem="{Binding articulo}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Numserie}">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <mat:PackIcon Kind="BarcodeScan" />
                                <TextBlock FontWeight="Bold" Text="Nº Serie" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Estado}">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <mat:PackIcon Kind="StateMachine" />
                                <TextBlock FontWeight="Bold" Text="Estado" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <mat:PackIcon Kind="Calendar" />
                                <TextBlock Text="FECHA DE ALTA" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding Fechaalta}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Binding="{Binding UsuarioaltaNavigation}">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <mat:PackIcon Kind="Account" />
                                <TextBlock Text="USUARIO" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>


                    <DataGridTextColumn Binding="{Binding ModeloNavigation.Nombre}">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <mat:PackIcon Kind="BoxUp" />
                                <TextBlock Text="MODELO" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding EspacioNavigation.Nombre}">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <mat:PackIcon Kind="AlphaEBox" />
                                <TextBlock Text="ESPACIO" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <mat:PackIcon Kind="InfoBox" />
                                <TextBlock Text="DATOS" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1*" />
                                        <RowDefinition Height="1*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Departamento" />
                                    <TextBlock Grid.Column="1" Text="{Binding DepartamentoNavigation.Nombre}" />

                                    <TextBlock Grid.Row="1" Text="NºPréstamos" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding Salida.Count}" />
                                </Grid>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>



                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            x:Name="editarArticuloContexto"
                            Click="editarArticuloLinea_click"
                            Header="Editar">
                            <MenuItem.Icon>
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="/Recursos/Iconos/prestamos.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>

                        <DockPanel>
                            <Grid Margin="0,0,0,5" DockPanel.Dock="Top">
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Text="Listado de prestamos del articulo" />
                            </Grid>
                            <Grid>
                                <ListBox ItemsSource="{Binding Salida}" />
                            </Grid>
                        </DockPanel>

                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>

            </DataGrid>
        </Grid>

    </DockPanel>

</UserControl>
