<UserControl
    x:Class="di.proyecto.clase._2025.Frontend.Dialogos.UCArbolEspacios"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ent="clr-namespace:di.proyecto.clase._2025.Backend.Modelos"
    xmlns:local="clr-namespace:di.proyecto.clase._2025.Frontend.Dialogos"
    xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="ucArbolEspacios"
    d:DesignHeight="650"
    d:DesignWidth="1200"
    Loaded="ucArbolEspacios_Loaded"
    mc:Ignorable="d">

    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <TextBlock
                Margin="10"
                HorizontalAlignment="Center"
                FontSize="32"
                Foreground="DarkViolet"
                Text="Administración de espacios" />
        </Grid>
        <Grid DockPanel.Dock="Left">
            <TreeView
                x:Name="treeEspacios"
                ItemsSource="{Binding Espacios}"
                SelectedItemChanged="treeEspacios_SelectedItemChanged">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type ent:Espacio}" ItemsSource="{Binding Articulos}">
                        <StackPanel Orientation="Horizontal">
                            <mat:PackIcon Width="16" Kind="Folder" />
                            <TextBlock FontSize="16" Text="{Binding Nombre}" />
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat=" ({0})">
                                        <Binding Path="Articulos.Count" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type ent:Articulo}" ItemsSource="{Binding Salida}">
                        <StackPanel Orientation="Horizontal">
                            <mat:PackIcon Width="16" Kind="ExitRun" />
                            <TextBlock FontSize="16" Text="{Binding Numserie}" />
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat=" ({0})">
                                        <Binding Path="Salida.Count" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type ent:Salidum}">
                        <StackPanel Orientation="Horizontal">
                            <mat:PackIcon Width="16" Kind="ExitToApp" />
                            <TextBlock FontSize="16" Text="{Binding Fechasalida}" />
                        </StackPanel>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Grid>
        <Grid DockPanel.Dock="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.ColumnSpan="3"
                Margin="20"
                FontSize="16"
                Foreground="DarkViolet"
                Text="MODIFICA LAS PROPIEDADES DEL ARTICULO" />
            <TextBox
                Grid.Row="1"
                Margin="20,0,20,0"
                mat:HintAssist.Hint="Número de serie"
                Foreground="#444"
                Text="{Binding ArticuloSeleccionado.Numserie}" />
            <TextBox
                Grid.Row="2"
                Grid.Column="0"
                Margin="20"
                FontSize="16"
                Foreground="#444"
                Text="{Binding ArticuloSeleccionado.Observaciones}" />
            <DatePicker
                Grid.Row="2"
                Grid.Column="3"
                Margin="20,0,20,0"
                Foreground="#444"
                SelectedDate="{Binding ArticuloSeleccionado.Fechaalta}" />
            <ComboBox
                Grid.Row="2"
                Grid.Column="1"
                Margin="20"
                mat:HintAssist.Hint="Estado del artículo"
                DisplayMemberPath="Nombre"
                Foreground="#444"
                ItemsSource="{Binding ListaEstado}"
                SelectedItem="{Binding ArticuloSeleccionado.Estado}" />
            <ComboBox
                Name="cbDepartamento"
                Grid.Row="1"
                Grid.Column="1"
                Width="150"
                Margin="20,0,20,0"
                mat:HintAssist.Hint="Departamento del artículo"
                DisplayMemberPath="Nombre"
                Foreground="#444"
                ItemsSource="{Binding ListaDepartamentos}"
                SelectedItem="{Binding ArticuloSeleccionado.DepartamentoNavigation}" />
            <ComboBox
                Name="cbEspacio"
                Grid.Row="2"
                Grid.Column="2"
                Width="150"
                Margin="20,0,20,0"
                mat:HintAssist.Hint="Espacio del artículo"
                DisplayMemberPath="Nombre"
                Foreground="#444"
                ItemsSource="{Binding Espacios}"
                SelectedItem="{Binding ArticuloSeleccionado.EspacioNavigation}" />
            <ComboBox
                Name="cbUsuario"
                Grid.Row="1"
                Grid.Column="3"
                Width="150"
                Margin="20,0,20,0"
                mat:HintAssist.Hint="Usuario del artículo"
                DisplayMemberPath="Nombre"
                Foreground="#444"
                ItemsSource="{Binding ListaUsuarios}"
                SelectedItem="{Binding ArticuloSeleccionado.UsuarioaltaNavigation}" />

            <ComboBox
                Name="cbModelo"
                Grid.Row="1"
                Grid.Column="2"
                Margin="20"
                mat:HintAssist.Hint="Modelo del artículo"
                DisplayMemberPath="Nombre"
                Foreground="#444"
                ItemsSource="{Binding ListaModelosArticulos}"
                SelectedItem="{Binding ArticuloSeleccionado.ModeloNavigation}" />
            <Button
                x:Name="btnModificarArticulo"
                Grid.Row="2"
                Grid.Column="4"
                Content="Modificar" />


        </Grid>
        <Grid x:Name="panelCentral">
            <DataGrid
                x:Name="dgArticulosPorEspacio"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                ColumnWidth="*"
                SelectedItem="{Binding ArticuloSeleccionado}"
                Style="{StaticResource MahApps.Styles.DataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Numserie}" Header="Número de Serie" />
                    <DataGridTextColumn Binding="{Binding ModeloNavigation}" Header="Modelo del artículo" />
                    <DataGridTextColumn Binding="{Binding UsuarioaltaNavigation.Nombre}" Header="Usuario" />
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding Fechaalta}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
